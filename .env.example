# =============================================================================
# xSmartDeepResearch 环境配置
# =============================================================================
# 复制此文件为 .env 并填入实际的API Keys和配置值
# cp .env.example .env

# =============================================================================
# 必需配置 - API Keys
# =============================================================================

# Serper API - 用于Google搜索和学术搜索
SERPER_API_KEY=d585b6c4df7e815239918eb8cd97423aab0c58d4

# Jina API - 用于网页内容读取
JINA_API_KEY=jina_d1031d7640e942d993c25cfa351a4f0djCxggp4nB7eOSquY7eo2DtbFwl6-

# --- LLM API Configuration (Kimi 优先, OpenRouter 兜底) ---
# 优先链路: KIMI_API_KEY + LLM_BASE_URL + LLM_MODEL
# 兜底链路: OPENROUTER_KEY/API_KEY + API_BASE + MODEL_NAME
KIMI_API_KEY=sk-sp-bb2b4954f369445fa65147d62cb4829c
LLM_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
LLM_MODEL=MiniMax-M2.5

# OpenAI兼容API - OpenRouter (Fallback)
OPENROUTER_KEY=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
API_KEY=your_openai_key_here
API_BASE=https://xsmartapi.fusionxlink.com/

# 摘要模型名称 (OpenRouter 格式)
SUMMARY_MODEL_NAME=openai/gpt-4o-mini

# =============================================================================
# 可选配置 - 扩展功能
# =============================================================================

# Dashscope API - 用于文件解析 (PDF、Office等)
DASHSCOPE_API_KEY=your_dashscope_key_here

# SandboxFusion - Python代码执行沙箱
SANDBOX_FUSION_ENDPOINT=http://localhost:8080

# =============================================================================
# 模型配置
# =============================================================================

# 主模型名称 (Fallback when LLM_MODEL is empty)
MODEL_NAME=z-ai/glm-4.7-flash

# =============================================================================
# Agent 配置
# =============================================================================

MAX_LLM_CALL_PER_RUN=100
MAX_CONTEXT_TOKENS=110000
TEMPERATURE=0.6
TOP_P=0.95
PRESENCE_PENALTY=1.1
VISIT_SERVER_TIMEOUT=200
WEBCONTENT_MAXLENGTH=150000

# =============================================================================
# 服务配置
# =============================================================================

API_HOST=0.0.0.0
API_PORT=8000
REDIS_URL=redis://localhost:6379

# =============================================================================
# 日志配置
# =============================================================================

LOG_LEVEL=INFO
LOG_DIR=./logs

# MySQL Database Configuration
DB_HOST=39.98.38.28
DB_PORT=3306
DB_NAME=xSmartDeepResearch
DB_USER=root
DB_PASSWORD=hs@A1b2c3d4e5